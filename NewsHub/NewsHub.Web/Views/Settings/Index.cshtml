@model SettingsViewModel
@using NewsHub.Domain.Enums
@using NewsHub.Web.Common.Extensions
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_LayoutNews.cshtml";
    ViewData["Title"] = "Settings";
}

@section Sidebar {
    @await Html.PartialAsync("PartialViews/Settings/SideBar")
}

<!-- Top bar -->
<header
    class="sticky top-0 z-30 h-16 bg-white/80 dark:bg-surface-900/80 backdrop-blur-md border-b border-surface-200 dark:border-surface-700 flex items-center px-6 gap-4 shrink-0">
    <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-800"
            aria-label="Menu">
        <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
    <h1 class="text-lg font-semibold flex items-center gap-2">
        <i data-lucide="settings" class="w-5 h-5 text-brand-500"></i>
        Configuracion
    </h1>
</header>

<main class="flex-1 p-6 space-y-8 max-w-4xl">

    <!-- ===== SECTION: Roles ===== -->
    <section
        class="bg-white dark:bg-surface-800 rounded-2xl border border-surface-200 dark:border-surface-700 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-surface-200 dark:border-surface-700">
            <h2 class="text-base font-semibold flex items-center gap-2">
                <i data-lucide="users" class="w-4 h-4 text-brand-500"></i>
                Asignar Roles
            </h2>
            <p class="text-sm text-surface-500 dark:text-surface-400 mt-0.5">Administra los roles de los usuarios
                registrados en el sistema.</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-surface-50 dark:bg-surface-800/50 text-surface-500 dark:text-surface-400">
                        <tr>
                            <th class="px-6 py-3 text-left font-medium">Usuario</th>
                            <th class="px-6 py-3 text-left font-medium">Email</th>
                            <th class="px-6 py-3 text-left font-medium">Rol</th>
                            <th class="px-6 py-3 text-left font-medium">Estado</th>
                            <th class="px-6 py-3 text-right font-medium">Accion</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-200 dark:divide-surface-700">
                        @if (Model.Users.Any())
                        {
                            @foreach (var users in Model.Users)
                            {
                                var colors = new[]
                                {
                                    ("bg-brand-100 dark:bg-brand-900/30", "text-brand-600 dark:text-brand-400"),
                                    ("bg-blue-100 dark:bg-blue-900/30", "text-blue-600 dark:text-blue-400"),
                                    ("bg-green-100 dark:bg-green-900/30", "text-green-600 dark:text-green-400"),
                                    ("bg-purple-100 dark:bg-purple-900/30", "text-purple-600 dark:text-purple-400"),
                                    ("bg-pink-100 dark:bg-pink-900/30", "text-pink-600 dark:text-pink-400")
                                };

                                var index = Math.Abs((users.Email ?? "").GetHashCode()) % colors.Length;
                                var bgClass = colors[index].Item1;
                                var textClass = colors[index].Item2;

                                var firstInitial = !string.IsNullOrWhiteSpace(users.FirstName)
                                    ? users.FirstName[0].ToString().ToUpper()
                                    : "";

                                var lastInitial = !string.IsNullOrWhiteSpace(users.LastName)
                                    ? users.LastName[0].ToString().ToUpper()
                                    : "";

                                var initials = $"{firstInitial}{lastInitial}";
                                var userRole = users.Role;

                                <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/50">
                                    <form asp-action="UpdateUser" asp-controller="Settings" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="UserId" value="@users.Id" />

                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div
                                                    class="w-8 h-8 rounded-full @bgClass flex items-center justify-center text-xs font-bold @textClass">
                                                    @initials
                                                </div>
                                                <span class="font-medium">
                                                    @($"{users.FirstName} {users.LastName}")
                                                </span>
                                            </div>
                                        </td>

                                        <td class="px-6 py-4 text-surface-500">
                                            @users.Email
                                        </td>

                                        <td class="px-6 py-4">
                                            <select name="Role"
                                                    asp-items="@(new SelectList(EnumExtensions.ToSelectList<RolesEnums>(), "Value", "Text", users.Role.ToString()))"
                                                    class="px-3 py-1.5 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                                            </select>
                                        </td>

                                        <td class="px-6 py-4">
                                            <select name="IsActive"
                                                    class="px-3 py-1.5 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                                                <option value="true" selected="@(users.IsActive)">Activo</option>
                                                <option value="false" selected="@(!users.IsActive)">Inactivo</option>
                                            </select>
                                        </td>

                                        <td class="px-6 py-4 text-right">
                                            <button type="submit"
                                                    class="px-3 py-1.5 text-xs font-medium rounded-lg bg-brand-500 text-white hover:bg-brand-600 transition-colors">
                                                Guardar
                                            </button>
                                        </td>
                                    </form>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="px-6 py-10 text-center text-surface-500 dark:text-surface-400">
                                    <div class="flex flex-col items-center gap-2">
                                        <i data-lucide="users" class="w-6 h-6 text-surface-300"></i>
                                        <span class="text-sm font-medium">No hay usuarios registrados</span>
                                        <span class="text-xs text-surface-400">Agrega un usuario para comenzar</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ===== SECTION: Secrets ===== -->
        <section
            class="bg-white dark:bg-surface-800 rounded-2xl border border-surface-200 dark:border-surface-700 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-surface-200 dark:border-surface-700">
                <h2 class="text-base font-semibold flex items-center gap-2">
                    <i data-lucide="key-round" class="w-4 h-4 text-brand-500"></i>
                    Secrets
                </h2>
                <p class="text-sm text-surface-500 dark:text-surface-400 mt-0.5">Claves API y credenciales asociadas a las
                    fuentes de datos.</p>
                </div>
                <div class="p-6">
                    <!-- Add secret form -->
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-5">
                        <input type="text" placeholder="Clave (Key)"
                               class="px-3 py-2 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                        <input type="text" placeholder="Valor (Value)"
                               class="px-3 py-2 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                        <select
                            class="px-3 py-2 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            <option value="">Asociar a fuente...</option>
                            <option value="1">NewsAPI</option>
                            <option value="2">TechCrunch RSS</option>
                            <option value="3">HackerNews</option>
                        </select>
                        <button
                            class="px-4 py-2 text-sm font-medium rounded-lg bg-brand-500 text-white hover:bg-brand-600 transition-colors flex items-center justify-center gap-2">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            Agregar
                        </button>
                    </div>
                    <!-- Secrets table -->
                    <div class="overflow-x-auto rounded-xl border border-surface-200 dark:border-surface-700">
                        <table class="w-full text-sm">
                            <thead class="bg-surface-50 dark:bg-surface-800/50 text-surface-500">
                                <tr>
                                    <th class="px-4 py-2.5 text-left font-medium">Clave</th>
                                    <th class="px-4 py-2.5 text-left font-medium">Valor</th>
                                    <th class="px-4 py-2.5 text-left font-medium">Fuente</th>
                                    <th class="px-4 py-2.5 text-right font-medium">Accion</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-200 dark:divide-surface-700">
                                <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/50">
                                    <td class="px-4 py-3 font-mono text-xs">NEWSAPI_KEY</td>
                                    <td class="px-4 py-3 font-mono text-xs text-surface-400">••••••••••••a1b2</td>
                                    <td class="px-4 py-3"><span
                                        class="px-2 py-0.5 text-xs rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">NewsAPI</span>
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <button
                                            class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-surface-400 hover:text-red-600 transition-colors"><i
                                            data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                                        </td>
                                    </tr>
                                    <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/50">
                                        <td class="px-4 py-3 font-mono text-xs">HN_TOKEN</td>
                                        <td class="px-4 py-3 font-mono text-xs text-surface-400">••••••••••••x9y8</td>
                                        <td class="px-4 py-3"><span
                                            class="px-2 py-0.5 text-xs rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300">HackerNews</span>
                                        </td>
                                        <td class="px-4 py-3 text-right">
                                            <button
                                                class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-surface-400 hover:text-red-600 transition-colors"><i
                                                data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>

                    <!-- ===== SECTION: General Settings ===== -->
                    <section
                        class="bg-white dark:bg-surface-800 rounded-2xl border border-surface-200 dark:border-surface-700 shadow-sm overflow-hidden">
                        <div class="px-6 py-4 border-b border-surface-200 dark:border-surface-700">
                            <h2 class="text-base font-semibold flex items-center gap-2">
                                <i data-lucide="sliders-horizontal" class="w-4 h-4 text-brand-500"></i>
                                Configuracion General
                            </h2>
                            <p class="text-sm text-surface-500 dark:text-surface-400 mt-0.5">Ajustes generales de la aplicacion.</p>
                        </div>
                        <div class="p-6 space-y-5">
                            <div>
                                <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Nombre de la
                                    Aplicacion</label>
                                    <input type="text" value="NewsHub"
                                           class="w-full max-w-md px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Items por
                                        Pagina</label>
                                        <input type="number" value="12" min="1" max="100"
                                               class="w-full max-w-[120px] px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Intervalo de
                                            Actualizacion (minutos)</label>
                                            <input type="number" value="30" min="5" max="1440"
                                                   class="w-full max-w-[120px] px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                                        </div>
                                        <div class="pt-2">
                                            <button
                                                class="px-5 py-2.5 text-sm font-semibold rounded-xl bg-brand-500 text-white hover:bg-brand-600 shadow-lg shadow-brand-500/25 transition-all flex items-center gap-2">
                                                <i data-lucide="save" class="w-4 h-4"></i>
                                                Guardar Configuracion
                                            </button>
                                        </div>
                                    </div>
                                </section>

                            </main>