@model RegisterViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Register";
}

<!-- Register Card -->
<div class="bg-white dark:bg-surface-800 rounded-2xl border border-surface-200 dark:border-surface-700 shadow-xl shadow-surface-200/50 dark:shadow-surface-950/50 p-8">
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <!-- First Name -->
        <div class="mb-5">
            <label asp-for="FirstName" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Nombre</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="user" class="w-4 h-4 text-surface-400"></i>
                </div>
                <input asp-for="FirstName" type="text" placeholder="Juan"
                       class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 text-surface-900 dark:text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
        </div>
        <!-- Last Name -->
        <div class="mb-5">
            <label asp-for="LastName" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Apellidos</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="user" class="w-4 h-4 text-surface-400"></i>
                </div>
                <input asp-for="LastName" type="text" placeholder="Perez"
                       class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 text-surface-900 dark:text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="LastName" class="text-red-500 text-xs"></span>
        </div>
        <!-- Email -->
        <div class="mb-5">
            <label asp-for="Email" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Correo electronico</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="mail" class="w-4 h-4 text-surface-400"></i>
                </div>
                <input asp-for="Email" type="email" placeholder="juan@ejemplo.com"
                       class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 text-surface-900 dark:text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
        </div>
        <!-- Username -->
        <div class="mb-5">
            <label asp-for="UserName" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Nombre de usuario</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="at-sign" class="w-4 h-4 text-surface-400"></i>
                </div>
                <input asp-for="UserName" type="text" placeholder="juanperez"
                       class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 text-surface-900 dark:text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="UserName" class="text-red-500 text-xs"></span>
        </div>
        <!-- Password -->
        <div class="mb-5">
            <label asp-for="Password" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Contrasena</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="lock" class="w-4 h-4 text-surface-400"></i>
                </div>
                <input asp-for="Password" type="password" placeholder="********" minlength="6"
                       class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 text-surface-900 dark:text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
            <p class="mt-1.5 text-xs text-surface-400">
                Debe incluir mayúscula, minúscula, número y carácter especial.
            </p>
        </div>
        <!-- Confirm Password -->
        <div class="mb-6">
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Confirmar contrasena</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="lock" class="w-4 h-4 text-surface-400"></i>
                </div>
                <input asp-for="ConfirmPassword" type="password" placeholder="********" minlength="6"
                       class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 text-surface-900 dark:text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
        </div>
        <!-- Error message -->
        <div asp-validation-summary="ModelOnly" class="mb-4 p-3 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 text-sm flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
        </div>
        <!-- Submit -->
        <button type="submit"
                class="w-full flex items-center justify-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl bg-brand-500 text-white hover:bg-brand-600 shadow-lg shadow-brand-500/25 transition-all hover:shadow-xl hover:shadow-brand-500/30 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 dark:focus:ring-offset-surface-800">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            Crear cuenta
        </button>
    </form>
</div>

<!-- Login link -->
<div class="mt-6 text-center">
    <p class="text-sm text-surface-500 dark:text-surface-400">
        Ya tienes cuenta?
        <a asp-controller="Authentication" asp-action="Login" class="font-medium text-brand-600 dark:text-brand-400 hover:underline">Inicia sesion</a>
    </p>
</div>