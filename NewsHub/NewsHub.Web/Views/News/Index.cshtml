@model DashboardViewModel
@using System.Security.Claims
@using NewsHub.Domain.Enums
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_LayoutNews.cshtml";
    ViewData["Title"] = "Dashboard";
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Sin rol";
}

@section Styles {
    <link rel="stylesheet" href="~/css/views/dashboard.css" />
}

@section Sidebar {
    @await Html.PartialAsync("PartialViews/Dashboard/SideBar")
}

<!-- Top bar -->
<header class="sticky top-0 z-30 h-16 bg-white/80 dark:bg-surface-900/80 backdrop-blur-md border-b border-surface-200 dark:border-surface-700 flex items-center px-6 gap-4 shrink-0">
    <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-800" aria-label="Menu">
        <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
    <h1 class="text-lg font-semibold">Dashboard</h1>
    <div class="flex-1"></div>
    <!-- Stats -->
    <div class="hidden sm:flex items-center gap-4 text-xs text-surface-500">
        <span class="flex items-center gap-1"><i data-lucide="database" class="w-3.5 h-3.5"></i> 3 fuentes</span>
        <span class="flex items-center gap-1"><i data-lucide="file-text" class="w-3.5 h-3.5"></i> 9 items</span>
    </div>
</header>

@if (role == "Admin")
{
    <!-- Admin: Manage Sources Bar -->
    <div id="admin-bar" class="bg-white dark:bg-surface-900 border-b border-surface-200 dark:border-surface-700">
        <button onclick="toggleAdminBar()" class="w-full flex items-center justify-between px-6 py-3 text-sm font-medium text-surface-700 dark:text-surface-300 hover:bg-surface-50 dark:hover:bg-surface-800/50 transition-colors">
            <span class="flex items-center gap-2">
                <i data-lucide="shield" class="w-4 h-4 text-brand-500"></i>
                Gestionar Fuentes (Admin)
            </span>
            <i data-lucide="chevron-down" id="admin-chevron" class="w-4 h-4 transition-transform"></i>
        </button>
        <div id="admin-content" class="hidden px-6 pb-5">
            <!-- Add source form -->
            <form asp-controller="Source" asp-action="NewSource" method="post">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 mb-4">
                    <input asp-for="NewSource.Url" type="url" placeholder="URL de la fuente" class="lg:col-span-2 px-3 py-2 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-800 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                    
                    <input asp-for="NewSource.Name" type="text" placeholder="Nombre" class="px-3 py-2 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-800 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                    
                    <input asp-for="NewSource.Description" type="text" placeholder="Descripcion" class="px-3 py-2 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-800 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                    
                    <select asp-for="NewSource.ComponentType"
                            asp-items="Html.GetEnumSelectList<SourceType>()"
                            class="px-3 py-2 text-sm rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </select>
                    <div class="flex items-center gap-3">
                        <label class="flex items-center gap-1.5 text-xs text-surface-500">
                            <input asp-for="NewSource.RequiresSecret" type="checkbox" class="rounded border-surface-300 text-brand-500 focus:ring-brand-500" />
                            Secret
                        </label>
                        <button class="flex-1 px-3 py-2 text-sm font-medium rounded-lg bg-brand-500 text-white hover:bg-brand-600 transition-colors">
                            Agregar
                        </button>
                    </div>
                </div>
            </form>
            <!-- Sources table -->
            <div class="overflow-x-auto rounded-xl border border-surface-200 dark:border-surface-700">
                <table class="w-full text-sm">
                    <thead class="bg-surface-50 dark:bg-surface-800 text-surface-500 dark:text-surface-400">
                        <tr>
                            <th class="px-4 py-2.5 text-left font-medium">Nombre</th>
                            <th class="px-4 py-2.5 text-left font-medium hidden sm:table-cell">URL</th>
                            <th class="px-4 py-2.5 text-left font-medium">Tipo</th>
                            <th class="px-4 py-2.5 text-left font-medium hidden md:table-cell">Secret</th>
                            <th class="px-4 py-2.5 text-right font-medium">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-200 dark:divide-surface-700">
                        @if (Model.Sources != null && Model.Sources.Any())
                        {
                            @foreach (var source in Model.Sources)
                            {
                                <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/50">
                                    <td class="px-4 py-3 font-medium">
                                        @source.Name
                                    </td>

                                    <td class="px-4 py-3 text-surface-500 hidden sm:table-cell truncate max-w-[200px]">
                                        @source.Url
                                    </td>

                                    <td class="px-4 py-3">
                                        <span class="px-2 py-0.5 text-xs rounded-full
                                            @(source.ComponentType == SourceType.Api ? "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" :
                                                                                                                                                                                                                                                                        source.ComponentType == SourceType.Rss ? "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300" :
                                                                                                                                                                                                                                                                        "bg-brand-100 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300")">
                                            @source.ComponentType
                                        </span>
                                    </td>

                                    <td class="px-4 py-3 hidden md:table-cell">
                                        @if (source.RequiresSecret)
                                        {
                                            <i data-lucide="check" class="w-4 h-4 text-green-500"></i>
                                        }
                                        else
                                        {
                                            <i data-lucide="x" class="w-4 h-4 text-surface-300"></i>
                                        }
                                    </td>

                                    <td class="px-4 py-3 text-right">
                                        <button class="p-1.5 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-700 text-surface-400 hover:text-surface-600 edit-btn"
                                                data-id="@source.Id"
                                                data-name="@source.Name"
                                                data-url="@source.Url"
                                                data-description="@source.Description"
                                                data-type="@source.ComponentType"
                                                data-json="@source.ApiConfigJson"
                                                data-secret="@source.RequiresSecret">
                                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                        </button>
                                        <button onclick="openDeleteModal(2, 'TechCrunch RSS')" class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-surface-400 hover:text-red-600">
                                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="px-4 py-10 text-center text-surface-500 dark:text-surface-400">
                                    <div class="flex flex-col items-center gap-2">
                                        <i data-lucide="database" class="w-6 h-6 text-surface-300"></i>
                                        <span class="text-sm font-medium">No hay fuentes registradas</span>
                                        <span class="text-xs text-surface-400">Agrega una nueva fuente para comenzar</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}


<!-- Main content area -->
<main class="flex-1 p-6">

    <!-- Tabs -->
    <div class="flex gap-6 border-b border-surface-200 dark:border-surface-700 mb-6">
        <button onclick="switchTab('feed')" id="tab-feed" class="tab-btn pb-3 text-sm font-medium tab-active transition-colors">Feed</button>
        <button onclick="switchTab('saved')" id="tab-saved" class="tab-btn pb-3 text-sm font-medium text-surface-500 hover:text-surface-700 dark:hover:text-surface-300 transition-colors">Guardados</button>
        <button onclick="switchTab('upload')" id="tab-upload" class="tab-btn pb-3 text-sm font-medium text-surface-500 hover:text-surface-700 dark:hover:text-surface-300 transition-colors">Subir JSON</button>
    </div>

    <!-- ===== TAB: FEED ===== -->
    <div id="panel-feed" class="tab-panel">
        <!-- Search -->
        <div class="relative mb-6">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i data-lucide="search" class="w-4 h-4 text-surface-400"></i>
            </div>
            <input type="text" id="search-input" placeholder="Buscar noticias..." oninput="filterCards()"
                   class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-white dark:bg-surface-800 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all" />
        </div>
        <!-- Cards grid -->
        <div id="feed-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        </div>
    </div>

    <!-- ===== TAB: SAVED ===== -->
    <div id="panel-saved" class="tab-panel hidden">
        <div id="saved-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        </div>
        <div id="saved-empty" class="flex flex-col items-center justify-center py-20 text-center">
            <div class="w-16 h-16 rounded-2xl bg-surface-100 dark:bg-surface-800 flex items-center justify-center mb-4">
                <i data-lucide="bookmark" class="w-8 h-8 text-surface-300 dark:text-surface-600"></i>
            </div>
            <h3 class="text-lg font-semibold text-surface-500 dark:text-surface-400 mb-1">No hay items guardados</h3>
            <p class="text-sm text-surface-400 dark:text-surface-500 max-w-sm">Ve al Feed y guarda las noticias que te interesen. Apareceran aqui para acceso rapido.</p>
        </div>
    </div>

    <!-- ===== TAB: UPLOAD JSON ===== -->
    <div id="panel-upload" class="tab-panel hidden">
        <div class="max-w-2xl mx-auto">
            <div id="drop-zone" onclick="document.getElementById('file-input').click()"
                 class="border-2 border-dashed border-surface-300 dark:border-surface-600 rounded-2xl p-12 flex flex-col items-center justify-center text-center cursor-pointer hover:border-brand-400 hover:bg-brand-50/30 dark:hover:bg-brand-900/10 transition-colors">
                <div class="w-16 h-16 rounded-2xl bg-surface-100 dark:bg-surface-800 flex items-center justify-center mb-4">
                    <i data-lucide="upload-cloud" class="w-8 h-8 text-surface-400"></i>
                </div>
                <p class="text-sm font-medium text-surface-600 dark:text-surface-300 mb-1">Arrastra un archivo JSON aqui o haz clic para seleccionar</p>
                <p class="text-xs text-surface-400">Formato compatible con NewsHub (.json)</p>
                <input type="file" id="file-input" accept=".json" class="hidden" onchange="handleFileSelect(event)" />
            </div>
            <!-- Preview area -->
            <div id="json-preview" class="hidden mt-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold">Vista Previa del JSON</h3>
                    <button onclick="clearPreview()" class="text-xs text-surface-500 hover:text-red-500 transition-colors">Limpiar</button>
                </div>
                <pre id="json-content" class="p-4 rounded-xl bg-surface-900 dark:bg-surface-800 text-green-400 text-xs overflow-auto max-h-72 border border-surface-700"></pre>
                <button class="mt-4 w-full flex items-center justify-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl bg-brand-500 text-white hover:bg-brand-600 shadow-lg shadow-brand-500/25 transition-all">
                    <i data-lucide="database" class="w-4 h-4"></i>
                    Cargar a la base de datos
                </button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/views/dashboard/dashboard.data.js" asp-append-version="true"></script>
    <script src="~/js/views/dashboard/dashboard.ui.js" asp-append-version="true"></script>
    <script src="~/js/views/dashboard/dashboard.app.js" asp-append-version="true"></script>
    <script src="~/js/views/dashboard/dashboard.modal.js" asp-append-version="true"></script>
}

<!-- Modal: Editar Fuente -->
<div id="modal-edit" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="closeEditModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-white dark:bg-surface-800 rounded-2xl shadow-xl border border-surface-200 dark:border-surface-700 p-6">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-lg font-semibold">Editar Fuente</h3>
                <button onclick="closeEditModal()" class="p-1.5 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-700 text-surface-400">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form asp-controller="Source" asp-action="EditSource" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input asp-for="EditSource.Id" type="hidden" id="edit-id" />
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Nombre</label>
                    <input asp-for="EditSource.Name" type="text" required
                           class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">URL</label>
                    <input asp-for="EditSource.Url" type="url" required
                           class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Descripcion</label>
                    <input asp-for="EditSource.Description" type="text"
                           class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div id="api-config-container">
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">API Config JSON</label>
                    <textarea asp-for="EditSource.ApiConfigJson" rows="4" placeholder='{"headers": {}, "params": {}}'
                              class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono text-xs"></textarea>
                    <p class="text-xs text-surface-400 mt-1">Configuracion adicional en formato JSON (opcional)</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Tipo</label>
                        <select asp-for="EditSource.ComponentType"
                                asp-items="Html.GetEnumSelectList<SourceType>()"
                                class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            
                        </select>
                    </div>
                    <div class="flex items-end pb-1">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input asp-for="EditSource.RequiresSecret" type="checkbox" id="edit-secret" class="w-4 h-4 rounded border-surface-300 text-brand-500 focus:ring-brand-500" />
                            <span class="text-sm text-surface-600 dark:text-surface-400">Requiere Secret</span>
                        </label>
                    </div>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="closeEditModal()"
                            class="flex-1 px-4 py-2.5 text-sm font-medium rounded-xl border border-surface-200 dark:border-surface-600 text-surface-600 dark:text-surface-300 hover:bg-surface-50 dark:hover:bg-surface-700 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="flex-1 px-4 py-2.5 text-sm font-medium rounded-xl bg-brand-500 text-white hover:bg-brand-600 transition-colors">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Confirmar Eliminar -->
<div id="modal-delete" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-sm bg-white dark:bg-surface-800 rounded-2xl shadow-xl border border-surface-200 dark:border-surface-700 p-6 text-center">
            <div class="w-14 h-14 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="alert-triangle" class="w-7 h-7 text-red-600 dark:text-red-400"></i>
            </div>
            <h3 class="text-lg font-semibold mb-2">Eliminar Fuente</h3>
            <p class="text-sm text-surface-500 dark:text-surface-400 mb-1">Estas seguro de eliminar la fuente:</p>
            <p id="delete-source-name" class="text-sm font-semibold text-surface-700 dark:text-surface-200 mb-5"></p>
            <p class="text-xs text-surface-400 mb-5">Esta accion no se puede deshacer.</p>
            <input type="hidden" id="delete-id" />
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()"
                        class="flex-1 px-4 py-2.5 text-sm font-medium rounded-xl border border-surface-200 dark:border-surface-600 text-surface-600 dark:text-surface-300 hover:bg-surface-50 dark:hover:bg-surface-700 transition-colors">
                    Cancelar
                </button>
                <button onclick="confirmDelete()"
                        class="flex-1 px-4 py-2.5 text-sm font-medium rounded-xl bg-red-600 text-white hover:bg-red-700 transition-colors">
                    Eliminar
                </button>
            </div>
        </div>
    </div>
</div>