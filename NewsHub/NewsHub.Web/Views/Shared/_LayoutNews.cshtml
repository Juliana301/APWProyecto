<!DOCTYPE html>
<html lang="en" class="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NewsHub.Web</title>

    @* <script src="https://cdn.tailwindcss.com"></script> *@
    <script src="https://unpkg.com/lucide@latest"></script>

    <link rel="stylesheet" href="~/css/output.css"/>

    @RenderSection("Styles", required: false)
</head>
<body class="bg-surface-50 dark:bg-surface-950 text-surface-900 dark:text-surface-100 min-h-screen">

    <!-- Mobile overlay -->
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden"></div>

    @RenderSection("Modals", required: false)

    <div class="flex min-h-screen">

        @RenderSection("Sidebar", required: false)

        <!-- ========== MAIN CONTENT ========== -->
        <div class="flex-1 flex flex-col min-w-0">
           
            @RenderBody()

        </div>
    </div>

    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", false)
    @await Html.PartialAsync("PartialViews/Pop_ups/_Toast")
</body>
</html>

