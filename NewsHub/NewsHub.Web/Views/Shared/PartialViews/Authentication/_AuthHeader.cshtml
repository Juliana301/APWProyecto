@model AuthHeaderViewModel

<div class="flex flex-col items-center mb-8">
    
    <a href="/" class="flex items-center gap-2 mb-2">
        <div class="w-11 h-11 rounded-xl bg-brand-500 flex items-center justify-center shadow-lg shadow-brand-500/25">
            <i data-lucide="rss" class="w-6 h-6 text-white"></i>
        </div>
    </a>

    <h1 class="text-2xl font-bold text-surface-900 dark:text-surface-100">
        @Model.Title
    </h1>

    <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">
        @Model.Subtitle
    </p>

</div>