@using NewsHub.Domain.Enums
@model DashboardViewModel

<!-- Modal: Editar Fuente -->
<div id="modal-edit" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="closeEditModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div
            class="relative w-full max-w-md bg-white dark:bg-surface-800 rounded-2xl shadow-xl border border-surface-200 dark:border-surface-700 p-6">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-lg font-semibold">Editar Fuente</h3>
                <button onclick="closeEditModal()"
                        class="p-1.5 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-700 text-surface-400">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form asp-controller="Source" asp-action="EditSource" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input asp-for="EditSource.Id" type="hidden" id="edit-id" />
                <div>
                    <label
                    class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Nombre</label>
                    <input asp-for="EditSource.Name" type="text" required
                           class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">URL</label>
                    <input asp-for="EditSource.Url" type="url" required
                           class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div>
                    <label
                    class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Descripcion</label>
                    <input asp-for="EditSource.Description" type="text"
                           class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div id="api-config-container">
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">API Config
                        JSON</label>
                        <textarea asp-for="EditSource.ApiConfigJson" rows="4" placeholder='{"headers": {}, "params": {}}'
                                  class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono text-xs"></textarea>
                        <p class="text-xs text-surface-400 mt-1">Configuracion adicional en formato JSON (opcional)</p>
                    </div>
                    <div id="api-templates" class="mt-3 space-y-2">
                        <label class="block text-xs font-medium text-surface-500 mb-1">
                            Templates rápidos
                        </label>

                        <div class="flex flex-col gap-2 text-sm">

                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="apiTemplate" value="simple"
                                       class="text-brand-500 focus:ring-brand-500">
                                Simple API
                            </label>

                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="apiTemplate" value="idpipeline"
                                       class="text-brand-500 focus:ring-brand-500">
                                Id Pipeline (Hacker News)
                            </label>

                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="apiTemplate" value="apikey"
                                       class="text-brand-500 focus:ring-brand-500">
                                API con API Key
                            </label>

                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="apiTemplate" value="querykey"
                                       class="text-brand-500 focus:ring-brand-500">
                                API con API Key Query Param
                            </label>

                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="apiTemplate" value="paged"
                                       class="text-brand-500 focus:ring-brand-500">
                                API con Paginación
                            </label>

                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label
                            class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Tipo</label>
                            <select asp-for="EditSource.ComponentType" asp-items="Html.GetEnumSelectList<SourceType>()"
                                    class="w-full px-3 py-2.5 text-sm rounded-xl border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </select>
                        </div>
                        <div class="flex items-end pb-1">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input asp-for="EditSource.RequiresSecret" type="checkbox" id="edit-secret"
                                       class="w-4 h-4 rounded border-surface-300 text-brand-500 focus:ring-brand-500" />
                                <span class="text-sm text-surface-600 dark:text-surface-400">Requiere Secret</span>
                            </label>
                        </div>
                    </div>
                    <div class="flex gap-3 pt-2">
                        <button type="button" onclick="closeEditModal()"
                                class="flex-1 px-4 py-2.5 text-sm font-medium rounded-xl border border-surface-200 dark:border-surface-600 text-surface-600 dark:text-surface-300 hover:bg-surface-50 dark:hover:bg-surface-700 transition-colors">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="flex-1 px-4 py-2.5 text-sm font-medium rounded-xl bg-brand-500 text-white hover:bg-brand-600 transition-colors">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>